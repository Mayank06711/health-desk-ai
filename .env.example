# Runtime mode (false = local dev, true = docker)
RUNNING_IN_DOCKER=false

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM (swap provider by changing these 3)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.0-flash-001

# Deepgram
DEEPGRAM_API_KEY=

# Cartesia
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Simli (optional)
SIMLI_API_KEY=
SIMLI_FACE_ID=

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=voice_agent

# App
APP_ENV=development
LOG_LEVEL=INFO
