# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=voice_agent
POSTGRES_PORT=5433

# Database URL (used by backend)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/voice_agent

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI
OPENAI_API_KEY=

# Deepgram
DEEPGRAM_API_KEY=

# Cartesia
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Simli (optional)
SIMLI_API_KEY=
SIMLI_FACE_ID=

# App
APP_ENV=production
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
