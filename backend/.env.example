# Simli (optional, for avatar)
SIMLI_API_KEY=
SIMLI_FACE_ID=

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/voice_agent

# App
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
